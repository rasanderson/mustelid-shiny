#!/usr/bin/env bash

set -euo pipefail

SRC="$HOME/mustelid-spot/images/rnd1000"
DST="$HOME/MegaDetector-Classifier/data"
IMGDIR="$DST/imgs"

classes=(mink otter pinemarten polecat stoat weasel)

declare -A class_id=(
    [mink]=0
    [otter]=1
    [pinemarten]=2
    [polecat]=3
    [stoat]=4
    [weasel]=5
)

# Start clean
rm -rf "$IMGDIR"
mkdir -p "$IMGDIR"

CSV="$DST/annotations.csv"
echo "filename,class_id,class_name" > "$CSV"

for cls in "${classes[@]}"
do
    srcdir="$SRC/$cls"

    n=1

    while IFS= read -r -d '' file
    do
        printf -v newname "%s_%04d.jpg" "$cls" "$n"

        cp -- "$file" "$IMGDIR/$newname"

        printf '%s,%s,%s\n' \
            "$newname" \
            "${class_id[$cls]}" \
            "$cls" \
            >> "$CSV"

        ((n++))

    done < <(
        find "$srcdir" -maxdepth 1 -type f -name '*.jpg' -print0 | sort -z
    )

    echo "$cls: $((n-1)) files processed"
done

echo
echo "Images written to: $IMGDIR"
echo "CSV written to: $CSV"
echo "Total images: $(($(wc -l < "$CSV") - 1))"
